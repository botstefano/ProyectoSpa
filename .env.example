# Copia este archivo como ".env" y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# Configuración para servicio de email (EmailJS)
# EmailJS permite llamadas desde frontend sin problemas CORS
# Usamos un solo template universal para todos los tipos de email
# Obtén tus credenciales en https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=TU-SERVICE-ID
VITE_EMAILJS_TEMPLATE_ID=TU-TEMPLATE-ID
VITE_EMAILJS_PUBLIC_KEY=TU-PUBLIC-KEY

# Configuración alternativa para servicio de email (Resend)
# Solo necesario si prefieres usar Resend en lugar de EmailJS
# Obtén tu API key en https://resend.com/api-keys
VITE_RESEND_API_KEY=TU-RESEND-API-KEY
VITE_RESEND_FROM_EMAIL=onboarding@resend.dev

# Configuración para chatbot de propuestas (Mistral AI)
# Obtén tu API key en https://console.mistral.ai/api-keys
VITE_MISTRAL_API_KEY=TU-MISTRAL-API-KEY
